{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format json
	}

	reverse_proxy app:8000 {
		health_uri /health/ready
		health_interval 10s
		health_timeout 3s

		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
